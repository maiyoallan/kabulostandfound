NODE_ENV=development
PORT=4000
# Use your local PostgreSQL credentials. Never commit a real password.
DATABASE_URL=postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/kabu_lost_found?schema=public
# Generate a unique secret of at least 32 characters for each environment.
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CLIENT_ORIGIN=http://localhost:5173
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM=KABU Lost & Found <YOUR_VERIFIED_SENDER_ADDRESS>
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
# Optional comma-separated list; assign only trusted institutional administrators.
BOOTSTRAP_ADMIN_EMAILS=
